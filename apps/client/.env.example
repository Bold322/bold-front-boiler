# Client app runtime config (Vite reads VITE_* from apps/client/.env.local).
# Copy this file to apps/client/.env.local for local development.

# true  -> in-memory MockApiClient (no backend needed; log in with any email,
#          use an admin@... address to get the admin role).
# false -> real ApiClient against VITE_API_BASE_URL (bold-back-boiler).
VITE_USE_MOCK=true

# Base URL of the API server. Used only when VITE_USE_MOCK!=true.
VITE_API_BASE_URL=http://localhost:3000
