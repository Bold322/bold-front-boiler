# Super-admin console runtime config (Vite reads VITE_* from
# apps/super-admin/.env.local). Copy this file to apps/super-admin/.env.local.

# true  -> auto-bootstraps a fake superadmin session, no login, fully mock.
# false -> talks to the real API and requires a platform-superadmin login.
VITE_USE_MOCK=true

# Base URL of the API server. Used only when VITE_USE_MOCK!=true.
VITE_API_BASE_URL=http://localhost:3000
