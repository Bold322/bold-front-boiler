{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm nx build client",
  "outputDirectory": "dist/apps/client",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "framework": null,
  "rewrites": [
    { "source": "/((?!assets|.*\\..*).*)", "destination": "/index.html" }
  ]
}
